
DROP TABLE IF EXISTS rentals CASCADE;
DROP TABLE IF EXISTS vhs_tapes CASCADE;
DROP TABLE IF EXISTS movie_cast CASCADE;
DROP TABLE IF EXISTS movies CASCADE;
DROP TABLE IF EXISTS clients CASCADE;
DROP TABLE IF EXISTS actors CASCADE;
DROP TABLE IF EXISTS genres CASCADE;
DROP TABLE IF EXISTS directors CASCADE;


CREATE TABLE IF NOT EXISTS directors (
    id SERIAL PRIMARY KEY,
    full_name VARCHAR(150) NOT NULL,
    country VARCHAR(100),
    birth_year INT CHECK (birth_year > 0)
);

CREATE TABLE IF NOT EXISTS genres (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL UNIQUE,
    age_rating VARCHAR(10) DEFAULT '0+',
    description TEXT
);

CREATE TABLE IF NOT EXISTS actors (
    id SERIAL PRIMARY KEY,
    full_name VARCHAR(150) NOT NULL,
    birth_year INT CHECK (birth_year > 0),
    country VARCHAR(100)
);

CREATE TABLE IF NOT EXISTS clients (
    id SERIAL PRIMARY KEY,
    full_name VARCHAR(150) NOT NULL,
    passport_data VARCHAR(50) NOT NULL UNIQUE,
    phone VARCHAR(20) NOT NULL,
    registration_date DATE DEFAULT CURRENT_DATE
);



CREATE TABLE IF NOT EXISTS movies (
    id SERIAL PRIMARY KEY,
    title VARCHAR(200) NOT NULL,
    director_id INT REFERENCES directors(id) ON DELETE SET NULL,
    genre_id INT REFERENCES genres(id) ON DELETE SET NULL,
    release_year INT CHECK (release_year > 1800),
    rating_imdb NUMERIC(3, 1) CHECK (rating_imdb >= 0 AND rating_imdb <= 10)
);


CREATE TABLE IF NOT EXISTS movie_cast (
    movie_id INT REFERENCES movies(id) ON DELETE CASCADE,
    actor_id INT REFERENCES actors(id) ON DELETE CASCADE,
    PRIMARY KEY (movie_id, actor_id)
);

CREATE TABLE IF NOT EXISTS vhs_tapes (
    id SERIAL PRIMARY KEY,
    movie_id INT REFERENCES movies(id) ON DELETE CASCADE,
    inventory_number VARCHAR(50) NOT NULL UNIQUE,
    status VARCHAR(50) DEFAULT 'Доступна' CHECK (status IN ('Доступна', 'Выдана', 'В ремонте', 'Списана')),
    purchase_date DATE DEFAULT CURRENT_DATE
);


CREATE TABLE IF NOT EXISTS rentals (
    id SERIAL PRIMARY KEY,
    client_id INT REFERENCES clients(id) ON DELETE CASCADE,
    vhs_id INT REFERENCES vhs_tapes(id) ON DELETE SET NULL,
    rental_date DATE DEFAULT CURRENT_DATE,
    return_date DATE,
    rental_price NUMERIC(10, 2) NOT NULL CHECK (rental_price >= 0),
    overdue_fine NUMERIC(10, 2) DEFAULT 0.00 CHECK (overdue_fine >= 0),
    CHECK (return_date >= rental_date)
);



